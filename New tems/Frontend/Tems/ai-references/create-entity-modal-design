<!-- Create Modal -->
<div *ngIf="showCreateModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
  <div class="bg-white dark:bg-[#2c2c2e] rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-hidden my-8">
    <div class="bg-white dark:bg-[#2c2c2e] px-6 py-4 rounded-t-lg">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Create Ticket</h2>
        <button (click)="closeCreateModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <form [formGroup]="createForm" (ngSubmit)="onSubmit()" class="p-6 space-y-6 overflow-y-auto max-h-[calc(90vh-8rem)]">
      <!-- Ticket Type -->
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Ticket Type *</label>
        <app-custom-select
          formControlName="ticketTypeId"
          [options]="ticketTypeOptions"
          [searchable]="true"
          [allowEmpty]="false"
          placeholder="Search and select a ticket type"
          (ngModelChange)="onTicketTypeChange($event)">
        </app-custom-select>
        <p *ngIf="createForm.get('ticketTypeId')?.invalid && createForm.get('ticketTypeId')?.touched" class="text-red-500 dark:text-red-400 text-sm mt-1">
          Ticket type is required
        </p>
      </div>

      <!-- Issue Title -->
      <div *ngIf="selectedTicketType">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Ticket title *</label>
        <input
          type="text"
          formControlName="title"
          maxlength="50"
          placeholder="Give the issue a short title"
          class="w-full px-4 py-2 border border-gray-300 dark:border-[#38383a] dark:bg-[#3a3a3c] dark:text-white rounded-lg focus:ring-2 focus:ring-gray-900 dark:focus:ring-blue-500 focus:border-transparent"
          [class.border-red-500]="createForm.get('title')?.invalid && createForm.get('title')?.touched">
        <div class="mt-1 flex items-center justify-between gap-3">
          <p *ngIf="createForm.get('title')?.invalid && createForm.get('title')?.touched" class="text-red-500 dark:text-red-400 text-sm">
            Issue title is required and must be 50 characters or fewer
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 ml-auto">{{ (createForm.get('title')?.value?.length || 0) }}/50</p>
        </div>
      </div>

      <!-- Problem Description -->
      <div *ngIf="selectedTicketType">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Ticket description *</label>
        <textarea
          formControlName="summary"
          rows="4"
          placeholder="Describe what happened, what you expected, and any useful context"
          class="w-full px-4 py-2 border border-gray-300 dark:border-[#38383a] dark:bg-[#3a3a3c] dark:text-white rounded-lg focus:ring-2 focus:ring-gray-900 dark:focus:ring-blue-500 focus:border-transparent resize-none"
          [class.border-red-500]="createForm.get('summary')?.invalid && createForm.get('summary')?.touched">
        </textarea>
        <p *ngIf="createForm.get('summary')?.invalid && createForm.get('summary')?.touched" class="text-red-500 dark:text-red-400 text-sm mt-1">
          Problem description is required and must be 2000 characters or fewer
        </p>
      </div>

      <!-- Priority -->
      <div *ngIf="selectedTicketType">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Priority *</label>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <label *ngFor="let priority of priorities" class="relative flex items-center justify-center">
            <input
              type="radio"
              formControlName="priority"
              [value]="priority.value"
              class="sr-only peer">
            <div class="w-full px-4 py-2 border border-gray-300 dark:border-[#38383a] rounded-lg cursor-pointer peer-checked:border-gray-900 dark:peer-checked:border-blue-500 peer-checked:bg-gray-50 dark:peer-checked:bg-blue-500/20 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors text-center">
              <span class="inline-flex items-center justify-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                <span
                  class="inline-block w-2.5 h-2.5 rounded-full ring-1 ring-black/10 dark:ring-white/10"
                  [ngClass]="priority.dotClass"></span>
                <span>{{ priority.label }}</span>
              </span>
            </div>
          </label>
        </div>
        <p *ngIf="createForm.get('priority')?.invalid && createForm.get('priority')?.touched" class="text-red-500 dark:text-red-400 text-sm mt-1">
          Priority is required
        </p>
      </div>

      <!-- Dynamic Attributes -->
      <div *ngIf="hasAdditionalFields" 
           class="pt-6">
        <div class="space-y-4">
          <div *ngFor="let attr of editableAttributeDefinitions">
            <!-- Text/String Input -->
            <div *ngIf="attr.dataType === 'STRING'" class="form-group">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                {{ attr.label }}
                <span *ngIf="attr.isRequired" class="text-red-500">*</span>
              </label>
              <input
                type="text"
                [(ngModel)]="dynamicAttributeValues[attr.key]"
                [ngModelOptions]="{standalone: true}"
                [placeholder]="attr.label"
                class="w-full px-4 py-2 border border-gray-300 dark:border-[#38383a] dark:bg-[#3a3a3c] dark:text-white rounded-lg focus:ring-2 focus:ring-gray-900 dark:focus:ring-blue-500 focus:border-transparent"
                [class.border-red-500]="attr.isRequired && !isAttributeValid(attr.key)" />
              <p *ngIf="attr.isRequired && !isAttributeValid(attr.key)" class="text-red-500 dark:text-red-400 text-sm mt-1">
                {{ attr.label }} is required
              </p>
            </div>

            <!-- Boolean Checkbox -->
            <div *ngIf="attr.dataType === 'BOOL'" class="form-group">
              <label class="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  [(ngModel)]="dynamicAttributeValues[attr.key]"
                  [ngModelOptions]="{standalone: true}"
                  class="w-4 h-4 text-gray-900 dark:text-blue-500 border-gray-300 dark:border-gray-600 rounded focus:ring-gray-900 dark:focus:ring-blue-500" />
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  {{ attr.label }}
                  <span *ngIf="attr.isRequired" class="text-red-500">*</span>
                </span>
              </label>
            </div>

            <!-- Dropdown Select -->
            <div *ngIf="attr.dataType === 'DROPDOWN'" class="form-group">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                {{ attr.label }}
                <span *ngIf="attr.isRequired" class="text-red-500">*</span>
              </label>
              <select
                [(ngModel)]="dynamicAttributeValues[attr.key]"
                [ngModelOptions]="{standalone: true}"
                [disabled]="!attr.options || attr.options.length === 0"
                class="w-full px-4 py-2 border border-gray-300 dark:border-[#38383a] dark:bg-[#3a3a3c] dark:text-white rounded-lg focus:ring-2 focus:ring-gray-900 dark:focus:ring-blue-500 focus:border-transparent"
                [class.border-red-500]="attr.isRequired && !isAttributeValid(attr.key)"
                [class.bg-gray-100]="!attr.options || attr.options.length === 0"
                [class.dark:bg-[#1c1c1e]]="!attr.options || attr.options.length === 0">
                <option value="">{{ (!attr.options || attr.options.length === 0) ? 'No options available' : 'Select ' + attr.label }}</option>
                <option *ngFor="let option of attr.options" [value]="option">{{ option }}</option>
              </select>
              <p *ngIf="!attr.options || attr.options.length === 0" class="text-amber-600 dark:text-amber-400 text-sm mt-1">
                ⚠️ No options configured for this dropdown. Please edit the ticket type to add options.
              </p>
              <p *ngIf="attr.isRequired && !isAttributeValid(attr.key) && attr.options && attr.options.length > 0" class="text-red-500 dark:text-red-400 text-sm mt-1">
                {{ attr.label }} is required
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <button
          type="button"
          (click)="closeCreateModal()"
          class="tems-btn tems-btn-secondary flex-1">
          Cancel
        </button>
        <button
          type="submit"
          [disabled]="isSubmitDisabled"
          class="tems-btn tems-btn-primary flex-1 disabled:opacity-50 disabled:cursor-not-allowed">
          {{ isSubmitting ? 'Creating...' : 'Create Ticket' }}
        </button>
      </div>
    </form>
  </div>
</div>